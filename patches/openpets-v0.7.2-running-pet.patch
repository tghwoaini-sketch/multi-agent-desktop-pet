+// Replaces only the indeterminate working spinner with live frames from the
+// active pet. It does not change task state or bridge polling.
+private struct OpenPetsRunningPetIndicator: View {
+    let frames: [CGImage]
+
+    var body: some View {
+        TimelineView(.periodic(from: .now, by: 0.15)) { context in
+            if let frame = runningFrame(at: context.date) {
+                Image(decorative: frame, scale: 1)
+                    .resizable()
+                    .interpolation(.none)
+                    .scaledToFit()
+                    .scaleEffect(x: -1, y: 1)
+                    .accessibilityLabel("任务正在运行")
+            } else {
+                ProgressView().scaleEffect(0.5).accessibilityLabel("任务正在运行")
+            }
+        }
+        .frame(width: 19, height: 19)
+    }
+
+    private func runningFrame(at date: Date) -> CGImage? {
+        guard !frames.isEmpty else { return nil }
+        return frames[Int(date.timeIntervalSinceReferenceDate / 0.15) % frames.count]
     }
 }
